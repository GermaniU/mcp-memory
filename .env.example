# ─── Almacenamiento (SQLite + FTS5, sin infra externa) ────────────────
# Archivo local. "~" se expande. ":memory:" para efímero (tests).
DB_PATH=~/.agent-memory/memory.db

# ─── MCP server ─────────────────────────────────────────────────────
MCP_PORT=8765
DEFAULT_NAMESPACE=default

# ─── CORS (vacío = cerrado, recomendado) ────────────────────────────
# Solo si un cliente WEB (navegador) necesita llamar al server. Lista de
# orígenes exactos separados por coma. Nunca uses "*".
# MCP_CORS_ORIGINS=http://localhost:3000
